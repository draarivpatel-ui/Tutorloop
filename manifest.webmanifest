{
  "name": "TutorLoop",
  "short_name": "TutorLoop",
  "description": "The back office for student tutors: sessions, payments, parent updates, and service hours.",
  "start_url": "./#dashboard",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8fafc",
